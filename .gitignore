# Build output
/bin/
/dist/

# The embedded UI bundle is generated by `task build:web`. Only the placeholder
# is tracked, so that `go build` works on a fresh clone before the web build has
# ever run -- go:embed fails outright on a missing directory.
/internal/httpapi/dist/*
!/internal/httpapi/dist/.gitkeep

# Node
node_modules/
web/node_modules/

# TLS material and any other secret generated into a working tree
*.pem
*.key

# Session-scoped tooling state
.gsd/
# go-task's staleness cache for the sources:/generates: checks
/.task/
.planning/milestone.lock

# OS noise
.DS_Store
.playwright-mcp/

# vitest's browser project writes failure screenshots and attachments beside the
# run. They are diagnostics for one run, not artifacts of the repository.
web/.vitest-attachments/
web/src/**/__screenshots__/
